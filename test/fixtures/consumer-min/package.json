{
  "_comment": [
    "Minimal consumer fixture for test/consumer-contract.bats. Every script this",
    "workflow family calls is present as a no-op so the contract can be asserted",
    "on any machine, including self-ci, without a live consumer checkout.",
    "Shape mirrors blinkbitcoin/react-native-mobile-template: same",
    "family-stem script names (check:types, check:unused, gen:i18n, ...), each",
    "the package script a make target of the same stem runs.",
    "A real consumer is never checked out here: its own Contract job holds it to the contract."
  ],
  "name": "consumer-min-fixture",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "expo": "~57.0.20",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "expo-doctor": "^1.20.4",
    "knip": "^6.34.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "check:types": "node -e 0",
    "check:lint": "node -e 0",
    "fix:lint": "node -e 0",
    "fix:format": "node -e 0",
    "check:format": "node -e 0",
    "check:unused": "node -e 0",
    "check:spell": "node -e 0",
    "check:docs": "node -e 0",
    "gen:i18n": "node -e 0",
    "gen:graphql": "node -e 0",
    "check:generated": "node -e 0",
    "test": "node -e 0",
    "test:coverage": "node -e 0",
    "test:scripts": "node -e 0",
    "build:web": "node -e 0",
    "test:e2e:web": "node -e 0",
    "test:e2e:ios": "node -e 0",
    "test:e2e:android": "node -e 0",
    "check:expo-health": "node -e 0",
    "check:audit": "node -e 0",
    "check:licenses": "node -e 0",
    "check:prebuild": "node -e 0",
    "check:ci": "node -e 0",
    "check:secrets": "node -e 0"
  }
}
