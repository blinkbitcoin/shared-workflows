{
  "_comment": [
    "Minimal consumer fixture for test/consumer-contract.bats. Every script this",
    "workflow family calls is present as a no-op so the contract can be asserted",
    "on any machine, including self-ci, without a live consumer checkout.",
    "Shape mirrors blinkbitcoin/react-native-mobile-template: same",
    "script names, `knip` as a devDependency and deliberately NOT as a script",
    "(a script named `knip` fails expo-doctor's package.json check).",
    "A real consumer is never checked out here: its own Contract job holds it to the contract."
  ],
  "name": "consumer-min-fixture",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "expo": "~57.0.20",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "expo-doctor": "^1.20.4",
    "knip": "^6.34.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "typecheck": "node -e 0",
    "lint": "node -e 0",
    "lint:fix": "node -e 0",
    "format": "node -e 0",
    "format:check": "node -e 0",
    "spell": "node -e 0",
    "check:docs": "node -e 0",
    "i18n:extract": "node -e 0",
    "i18n:check": "node -e 0",
    "codegen": "node -e 0",
    "codegen:check": "node -e 0",
    "test": "node -e 0",
    "test:coverage": "node -e 0",
    "test:scripts": "node -e 0",
    "badges:render": "node -e 0",
    "build:web": "node -e 0",
    "test:e2e:web": "node -e 0",
    "test:e2e:ios": "node -e 0",
    "test:e2e:android": "node -e 0",
    "deps:check": "node -e 0",
    "deps:audit": "node -e 0",
    "deps:licenses": "node -e 0",
    "check-prebuild": "node -e 0",
    "check-bundle-secrets": "node -e 0",
    "check:bundle-secrets": "node -e 0",
    "check:ci": "node -e 0",
    "check:secrets": "node -e 0"
  }
}
