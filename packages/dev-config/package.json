{
  "name": "@blinkbitcoin/dev-config",
  "version": "0.6.0",
  "description": "The shared developer-tooling baseline: the pinned tool table and the checks that enforce it.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blinkbitcoin/shared-workflows.git",
    "directory": "packages/dev-config"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "bin",
    "lib",
    "release",
    "contract.json",
    "interfaces.json",
    "versions.json",
    "README.md"
  ],
  "exports": {
    "./versions.json": "./versions.json",
    "./contract.json": "./contract.json",
    "./interfaces.json": "./interfaces.json",
    "./check-tool-versions": "./bin/check-tool-versions.mjs",
    "./check-consumer-contract": "./bin/check-consumer-contract.mjs",
    "./check-docs-tables": "./bin/check-docs-tables.mjs",
    "./check-diagrams": "./bin/check-diagrams.mjs",
    "./check-shell-locale": "./bin/check-shell-locale.mjs",
    "./check-make-target-names": "./bin/check-make-target-names.mjs",
    "./check-workflow-names": "./bin/check-workflow-names.mjs",
    "./check-coverage-empty": "./bin/check-coverage-empty.mjs"
  },
  "bin": {
    "check-tool-versions": "./bin/check-tool-versions.mjs",
    "check-consumer-contract": "./bin/check-consumer-contract.mjs",
    "check-docs-tables": "./bin/check-docs-tables.mjs",
    "check-diagrams": "./bin/check-diagrams.mjs",
    "check-shell-locale": "./bin/check-shell-locale.mjs",
    "check-make-target-names": "./bin/check-make-target-names.mjs",
    "check-workflow-names": "./bin/check-workflow-names.mjs",
    "check-coverage-empty": "./bin/check-coverage-empty.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
