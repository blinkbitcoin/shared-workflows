{
  "$comment": "The one pinned tool table for every repo on the baseline. scripts/self/check-versions.sh asserts scripts/lib/versions.sh and .mise.toml agree with this file, so a version lives in exactly one place. match: 'exact' means the whole version must agree; 'major' means only the major, for runtimes pinned loosely on purpose.",
  "tools": {
    "actionlint": { "version": "1.7.12", "args": ["-version"], "match": "exact" },
    "shellcheck": { "version": "0.11.0", "args": ["--version"], "match": "exact" },
    "typos": { "version": "1.50.1", "args": ["--version"], "match": "exact" },
    "yq": { "version": "4.53.6", "args": ["--version"], "match": "exact" },
    "lefthook": { "version": "2.1.14", "args": ["version"], "match": "exact" },
    "zizmor": { "version": "1.30.1", "args": ["--version"], "match": "exact" },
    "gitleaks": { "version": "8.30.1", "args": ["version"], "match": "exact" },
    "bats": { "version": "1.14.0", "args": ["--version"], "match": "exact" },
    "node": { "version": "24", "args": ["--version"], "match": "major" },
    "pnpm": { "version": "12", "args": ["--version"], "match": "major" }
  }
}
