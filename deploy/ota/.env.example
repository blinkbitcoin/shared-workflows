# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
#
# UNVERIFIED OFFLINE: these variable names come from the family's spec, not
# from a running server. Confirm them against the upstream README before the
# first deploy: https://github.com/expo-open-ota/expo-open-ota

# Public origin clients fetch manifests from. Must equal the app repository's
# EXPO_UPDATES_URL variable, scheme and path prefix included.
EOO_BASE_URL=https://updates.example.com

# local | s3
EOO_STORAGE_MODE=local

# Host port the reverse proxy forwards to (loopback only).
OTA_HOST_PORT=3000

# PEM private key from `npx expo-updates codesigning:generate`, newlines
# escaped as \n. It must match the certificate committed at
# in the app repository (see docs/ota.md).
EOO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Comma-separated publish tokens, one per environment. The GitHub secret
# OTA_PUBLISH_TOKEN in the app repository must be one of these. Generate with
# `openssl rand -hex 32`.
EOO_TOKENS=internal:CHANGE_ME,beta:CHANGE_ME,production:CHANGE_ME

# ---- EOO_STORAGE_MODE=s3 only (S3, Cloudflare R2, MinIO, ...) --------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# S3_BUCKET=expo-updates
# For R2/MinIO, the account endpoint:
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
